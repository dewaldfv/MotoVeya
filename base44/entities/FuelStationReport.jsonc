{
  "name": "FuelStationReport",
  "type": "object",
  "properties": {
    "station_id": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "closed",
        "wrong_location",
        "wrong_brand",
        "fuel_unavailable",
        "incorrect_details",
        "other"
      ]
    },
    "message": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed"
      ],
      "default": "pending"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "station_id",
    "report_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}