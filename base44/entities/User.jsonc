{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "moderator",
        "organizer",
        "user"
      ],
      "default": "user"
    },
    "nickname": {
      "type": "string"
    },
    "motorcycle_club": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_email": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "medical_notes": {
      "type": "string"
    },
    "medical_aid": {
      "type": "string"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "none"
      ],
      "default": "none",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "total_distance_km": {
      "type": "number",
      "default": 0
    },
    "total_rides": {
      "type": "number",
      "default": 0
    },
    "total_incidents": {
      "type": "number",
      "default": 0
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "profile_completed": {
      "type": "boolean",
      "default": false
    },
    "last_lat": {
      "type": "number"
    },
    "last_lng": {
      "type": "number"
    },
    "last_location_updated": {
      "type": "string",
      "format": "date-time"
    },
    "last_speed_kmh": {
      "type": "number"
    },
    "last_heading": {
      "type": "number"
    },
    "battery_level": {
      "type": "number"
    },
    "auto_join_voice": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}