{
  "name": "FuelProfile",
  "type": "object",
  "properties": {
    "bike_id": {
      "type": "string"
    },
    "bike_make": {
      "type": "string"
    },
    "bike_model": {
      "type": "string"
    },
    "baseline_l_per_100km": {
      "type": "number"
    },
    "adaptive_l_per_100km": {
      "type": "number"
    },
    "km_per_litre": {
      "type": "number"
    },
    "cost_per_km": {
      "type": "number"
    },
    "total_fuel_cost": {
      "type": "number"
    },
    "total_fuel_l": {
      "type": "number"
    },
    "total_distance_km": {
      "type": "number"
    },
    "refill_count": {
      "type": "number"
    },
    "confidence_score": {
      "type": "number"
    },
    "avg_price_per_litre": {
      "type": "number"
    },
    "estimated_range_km": {
      "type": "number"
    },
    "last_calculated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "bike_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}