{
  "name": "FuelStation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "town": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "opening_hours": {
      "type": "string"
    },
    "is_open_24h": {
      "type": "boolean",
      "default": false
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fuel_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_updated_at": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}