{
  "name": "CrashAlert",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "countdown",
        "active",
        "resolved",
        "false_alarm"
      ],
      "default": "active"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "notified_emergency_contact": {
      "type": "boolean",
      "default": false
    },
    "notified_emergency_services": {
      "type": "boolean",
      "default": false
    },
    "notified_nearby_riders": {
      "type": "boolean",
      "default": false
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "last_lat": {
      "type": "number"
    },
    "last_lng": {
      "type": "number"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "crash_indicators": {
      "type": "string"
    },
    "speed_at_impact": {
      "type": "number"
    },
    "heading_at_impact": {
      "type": "number"
    },
    "battery_level": {
      "type": "number"
    },
    "bike_make": {
      "type": "string"
    },
    "bike_model": {
      "type": "string"
    },
    "bike_year": {
      "type": "number"
    }
  },
  "required": [
    "rider_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}