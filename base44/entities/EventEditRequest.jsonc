{
  "name": "EventEditRequest",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "submitted_by_id": {
      "type": "string"
    },
    "change_payload": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "review_notes": {
      "type": "string"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "submitted_by_id",
    "change_payload",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.submitted_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.submitted_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.submitted_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}