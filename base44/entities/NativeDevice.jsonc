{
  "name": "NativeDevice",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "device_token_hash": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios"
      ]
    },
    "app_version": {
      "type": "string"
    },
    "last_lat": {
      "type": "number"
    },
    "last_lng": {
      "type": "number"
    },
    "last_accuracy": {
      "type": "number"
    },
    "last_speed_kmh": {
      "type": "number"
    },
    "last_heading": {
      "type": "number"
    },
    "last_location_at": {
      "type": "string",
      "format": "date-time"
    },
    "tracking_enabled": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "device_token_hash",
    "platform"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}