{
  "name": "Bike",
  "type": "object",
  "properties": {
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "engine_size_cc": {
      "type": "number"
    },
    "tank_capacity_l": {
      "type": "number"
    },
    "fuel_consumption_l_per_100km": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "make",
    "model"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}