{
  "name": "EventPhoto",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "uploader_id": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "file_uri",
    "uploader_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.archived": false
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}