{
  "name": "PrivacySetting",
  "type": "object",
  "properties": {
    "show_motorcycle": {
      "type": "boolean",
      "default": true
    },
    "show_weekly_stats": {
      "type": "boolean",
      "default": true
    },
    "share_live_location": {
      "type": "boolean",
      "default": true
    },
    "location_group_rides_only": {
      "type": "boolean",
      "default": false
    },
    "background_sharing_enabled": {
      "type": "boolean",
      "default": false
    },
    "location_audience": {
      "type": "string",
      "enum": [
        "nobody",
        "friends",
        "group_rides",
        "favorite_friends",
        "emergency_contacts"
      ],
      "default": "friends"
    },
    "post_ride_share_duration": {
      "type": "string",
      "enum": [
        "immediate",
        "15min",
        "1hour",
        "until_stopped"
      ],
      "default": "immediate"
    },
    "gps_update_interval_sec": {
      "type": "number",
      "default": 10
    },
    "show_completed_rides": {
      "type": "boolean",
      "default": true
    },
    "show_events": {
      "type": "boolean",
      "default": true
    },
    "show_achievements": {
      "type": "boolean",
      "default": true
    },
    "show_fuel_stats": {
      "type": "boolean",
      "default": false
    },
    "show_photos": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}