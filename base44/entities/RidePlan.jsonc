{
  "name": "RidePlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "waypoints": {
      "type": "string"
    },
    "route_data": {
      "type": "string"
    },
    "route_distance_km": {
      "type": "number"
    },
    "route_duration_minutes": {
      "type": "number"
    },
    "route_engine": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "planned_date": {
      "type": "string",
      "format": "date-time"
    },
    "weather": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}