{
  "name": "RidePlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "waypoints": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "planned_date": {
      "type": "string",
      "format": "date-time"
    },
    "weather": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}