{
  "name": "GroupMember",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_nickname": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "leader",
        "member"
      ],
      "default": "member"
    },
    "last_lat": {
      "type": "number"
    },
    "last_lng": {
      "type": "number"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "left",
        "arrived"
      ],
      "default": "active"
    }
  },
  "required": [
    "group_id",
    "user_id"
  ]
}