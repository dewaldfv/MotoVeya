{
  "name": "ServiceRecord",
  "type": "object",
  "properties": {
    "bike_id": {
      "type": "string"
    },
    "bike_make": {
      "type": "string"
    },
    "bike_model": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "oil_change",
        "chain_sprockets",
        "tyres",
        "brakes",
        "battery",
        "general_service",
        "major_service",
        "suspension",
        "electrical",
        "other"
      ],
      "default": "general_service"
    },
    "description": {
      "type": "string"
    },
    "workshop_name": {
      "type": "string"
    },
    "cost_zar": {
      "type": "number"
    },
    "odometer_km": {
      "type": "number"
    },
    "service_date": {
      "type": "string",
      "format": "date-time"
    },
    "next_service_km": {
      "type": "number"
    }
  },
  "required": [
    "bike_id",
    "service_type",
    "service_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}