{
  "description": "Sends a push notification to all app users when a new event is added",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_event_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_users": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notify-new-event",
            "args": {
              "event_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify all users of new event",
            "description": "Push + in-app notification"
          }
        }
      }
    ]
  },
  "name": "New Event Notification"
}